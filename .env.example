# Copy this file to .env and fill in values locally. Never commit .env.
# Groq API (OpenAI-compatible endpoint)
XAI_API_KEY=
XAI_BASE_URL=https://api.groq.com/openai/v1
XAI_MODEL=openai/gpt-oss-120b

# Flagsmith Management API (secret; server-side only)
FLAGSMITH_API_TOKEN=
# Development environment SDK key (used as the environment identifier in the Management API path)
FLAGSMITH_ENVIRONMENT_KEY=
FLAGSMITH_API_URL=https://api.flagsmith.com
# Only these flags can be changed by the approval-based rollback endpoint.
ROLLBACK_ALLOWED_FLAGS=new_checkout

PORT=5000
